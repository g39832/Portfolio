# Copy to /etc/graysoncodes-blog.env (sudo install -m 644 -o root -g root deploy/blog.env.example /etc/graysoncodes-blog.env)
# No secrets are required: sessions are random tokens stored in the database.

# Where the database and uploaded images live. Must survive updates; never inside the git checkout.
BLOG_DATA_DIR=/var/lib/graysoncodes-blog/data
# Where `python -m blogapp backup` writes archives (also used by the nightly timer).
BLOG_BACKUP_DIR=/home/grayson/blog-backups

# Public address used in canonical links, the RSS feed and the sitemap.
BLOG_SITE_URL=https://graysoncodes.org
BLOG_SITE_NAME=Grayson Cox
BLOG_AUTHOR_NAME=Grayson Cox
# Time zone for showing dates and for the "schedule for later" box.
BLOG_TIMEZONE=America/Chicago

# Waitress listens only on localhost; nginx forwards to it.
BLOG_HOST=127.0.0.1
BLOG_PORT=5080
BLOG_THREADS=4

# Admin cookies are HTTPS-only. Leave on: Cloudflare serves the site over HTTPS.
BLOG_COOKIE_SECURE=1
# Use Cloudflare's CF-Connecting-IP header to rate-limit sign-in attempts per visitor.
BLOG_TRUST_CLOUDFLARE_IP=1

# Optional tuning (defaults shown).
#BLOG_MAX_UPLOAD_MB=10
#BLOG_PER_PAGE=9
#BLOG_SESSION_IDLE_HOURS=12
#BLOG_SESSION_MAX_DAYS=7
#BLOG_LOGIN_MAX_PER_IP=5
#BLOG_LOGIN_MAX_PER_USER=20
#BLOG_LOGIN_WINDOW_MINUTES=15

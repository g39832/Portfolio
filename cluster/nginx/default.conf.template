# nginx for the cluster: serves the built portfolio and forwards blog paths to the
# blog service. Same paths as the old Pi's nginx (blog/deploy/nginx-blog.conf).
# This is a template: at start-up the nginx image fills in the cluster's DNS
# server and the blog's and Campaign Ledger's addresses (BLOG_UPSTREAM, LEDGER_UPSTREAM),
# then writes it to conf.d/default.conf.
# Those addresses are looked up per request, so nginx starts even if an app is down.
resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

# Visitors arrive through the Cloudflare tunnel, so nginx only sees the
# cloudflared pods (10.42.x.x, the cluster's pod network). Cloudflare puts the
# real visitor's IP in CF-Connecting-IP; use it for logs and the apps behind.
# CrowdSec (k8s/80-crowdsec.yaml) reads these logs to spot attackers.
# (Applies to both sites below.)
set_real_ip_from 10.42.0.0/16;
real_ip_header CF-Connecting-IP;

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    set $blog_upstream ${BLOG_UPSTREAM};

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;

    location / {
        try_files $uri $uri/ =404;
    }

    # Vite puts a content hash in these file names, so they can be cached for a long time.
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /blog              { include /etc/nginx/conf.d/blog-proxy.inc; }
    location ^~ /blog/            { include /etc/nginx/conf.d/blog-proxy.inc; }
    location = /sitemap.xml       { include /etc/nginx/conf.d/blog-proxy.inc; }
    location ^~ /media/           { include /etc/nginx/conf.d/blog-proxy.inc; }
    location ^~ /admin/blog {
        client_max_body_size 12m;   # image uploads (the app itself limits images to 10 MB)
        include /etc/nginx/conf.d/blog-proxy.inc;
    }

    # Lets the cluster check this container is alive.
    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }
}

# dnd.graysoncodes.org: Campaign Ledger. The tunnel sends this host here (not straight
# to the app) so its visits are logged like the main site's and CrowdSec watches them.
server {
    listen 8080;
    listen [::]:8080;
    server_name dnd.graysoncodes.org;

    set $ledger_upstream ${LEDGER_UPSTREAM};
    client_max_body_size 25m;          # the app's own upload limit (maps, pictures)

    location / {
        proxy_pass $ledger_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Live updates (/api/play/events) keep one request open and stream through it:
        # pass data on straight away and don't cut the connection after 60 seconds.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }
}
